# ==============================================================================
# AI Interview & Video Intelligence Assistant — Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview_intelligence

# JWT Secret Key & Token Expiry
SECRET_KEY=change-this-to-a-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration ("gemini" or "mistral")
LLM_PROVIDER=gemini

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Mistral AI API Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Optional Sarvam AI Key for Hinglish Translation
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v2.5

# Embeddings & Vector Store Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_DIR=./vector_db

# Speech-to-Text Model ("tiny", "base", "small", "medium", "large")
WHISPER_MODEL=base

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
